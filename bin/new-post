#!/usr/bin/env bash
# Start a draft: bin/new-post "My post title" [Tag1 Tag2 ...]
# Copies _drafts/template.md to _drafts/<slug>.md; it shows up in bin/serve but not on the live site.
set -euo pipefail
cd "$(dirname "$0")/.."

[ $# -ge 1 ] || { echo 'usage: bin/new-post "Post title" [Tag1 Tag2 ...]'; exit 1; }
title="$1"; shift
slug=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
file="_drafts/$slug.md"
[ -e "$file" ] && { echo "$file already exists"; exit 1; }

# The template's placeholders: "Post title", "Tag1 Tag2" and post-slug.
export TITLE="${title//\"/\\\"}" TAGS="$*" SLUG="$slug"
perl -pe 's/^title:  "Post title"/title:  "$ENV{TITLE}"/; s/^tags: Tag1 Tag2/tags: $ENV{TAGS}/; s/post-slug/$ENV{SLUG}/g' \
  _drafts/template.md > "$file"
echo "Created $file (images go in assets/img/$slug/)"
