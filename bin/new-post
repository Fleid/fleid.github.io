#!/usr/bin/env bash
# Start a draft: bin/new-post "My post title" [Tag1 Tag2 ...]
# Creates _drafts/<slug>.md; it shows up in bin/serve but not on the live site.
set -euo pipefail
cd "$(dirname "$0")/.."

[ $# -ge 1 ] || { echo 'usage: bin/new-post "Post title" [Tag1 Tag2 ...]'; exit 1; }
title="$1"; shift
slug=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
file="_drafts/$slug.md"
[ -e "$file" ] && { echo "$file already exists"; exit 1; }

cat > "$file" <<EOF
---
layout: post
title:  "$title"
tags: $*
permalink: /$slug/
---

Intro paragraph: this is the excerpt shown on the home page.

<!--more-->

## First section

Images: put them in assets/img/$slug/ and use ![Alt text](/assets/img/$slug/picture.png)
EOF
echo "Created $file (images go in assets/img/$slug/)"
